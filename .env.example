# Vabatim Environment Configuration Example

NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://vabatim:vabatim@localhost:5432/vabatim_db"
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Must be a unique value of >= 32 characters. Startup fails in production otherwise.
JWT_SECRET="development-secret-change-in-prod"
JWT_EXPIRES_IN="24h"

# Speech Recognition Provider Config
# Options: device, mock, google, azure
#
#   device  Browser recognition. Immediate on-screen text, but CANNOT separate speakers and
#           cannot be biased toward clinical vocabulary. Statements are recorded as
#           unattributed. Suitable for demos, not for clinical documentation.
#   google  Google Cloud Speech-to-Text with speaker diarisation and boosted clinical
#           phrase sets. Requires GOOGLE_SPEECH_API_KEY or GOOGLE_ACCESS_TOKEN.
#   azure   Azure AI Speech fast transcription with diarisation and phrase lists. Requires
#           AZURE_SPEECH_KEY and AZURE_SPEECH_REGION. Use uksouth to keep audio in-region.
SPEECH_PROVIDER=device
SPEECH_LANGUAGE=en-GB

GOOGLE_SPEECH_API_KEY=
GOOGLE_ACCESS_TOKEN=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# LLM Intelligence Layer Config
# Options: mock, gemini, openai
LLM_PROVIDER=mock
GEMINI_API_KEY=
# Leave blank to auto-resolve a model this API key can use.
GEMINI_MODEL=

# Object Storage Config
# Options: local, s3, supabase
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET_NAME=vabatim-clinical-storage

# Email Provider Config
# Options: mock, smtp, resend
EMAIL_PROVIDER=mock

# App Base URL for Secure Delivery Links
APP_BASE_URL="http://localhost:3000"
RENDER_EXTERNAL_URL=
